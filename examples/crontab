# Example user crontab for `cron-explain --file examples/crontab`
SHELL=/bin/bash
MAILTO=""

# Sync every 15 minutes during office hours (Dhaka)
CRON_TZ=Asia/Dhaka
*/15 9-17 * * 1-5  /usr/local/bin/sync --quiet

# Nightly backup and a monthly report (UTC)
CRON_TZ=UTC
30 2 * * *         /usr/local/bin/backup.sh >> /var/log/backup.log 2>&1
0 6 1 * *          /usr/local/bin/monthly-report
@reboot            /usr/local/bin/warm-cache
